{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "cross-env NODE_ENV=production tsx server.ts",
    "vercel-build": "npm run build",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@devwareng/vanilla-ts": "^1.6.114",
    "@tailwindcss/vite": "^4.1.13",
    "animate.css": "^4.1.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "framer": "^2.4.1",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.1",
    "cross-env": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "framer"
  ]
}